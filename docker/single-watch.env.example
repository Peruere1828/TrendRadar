# Copy this file to .env and fill in your own values before running:
# docker compose -f docker/docker-compose.single-watch.yml --env-file .env up -d

TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
WEBSERVER_PORT=8080

# Optional initial values. You can also edit these in the web page:
# http://localhost:8080/single_watch
#
# The page, RSS feed, or People.cn channel URL to watch.
WATCH_URL=http://finance.people.com.cn/
WATCH_SOURCE_NAME=People.cn Finance/Tech

# Separate multiple keywords with commas.
WATCH_KEYWORDS=具身智能,机器人,人形机器人

# Check interval in seconds.
CHECK_INTERVAL=1800

# How many links/items to inspect per check.
WATCH_MAX_ITEMS=30

# Maximum article-body characters included in each email.
WATCH_MAX_CONTENT_CHARS=8000

# true: first run sends currently matching items.
# false: first run only records the baseline and sends nothing.
WATCH_NOTIFY_ON_FIRST_RUN=true

# true: use Jina Reader first, then fall back to local HTML extraction.
WATCH_USE_JINA=true
JINA_API_KEY=

# true: generate an AI summary from the extracted article body before the body excerpt.
# If AI_API_KEY is empty, the watcher will skip AI summary and still send body excerpts.
WATCH_AI_SUMMARY_ENABLED=true
WATCH_AI_MODEL=
WATCH_AI_SUMMARY_MAX_INPUT_CHARS=6000
WATCH_AI_SUMMARY_MAX_TOKENS=700
AI_API_KEY=
AI_API_BASE=
AI_MODEL=deepseek/deepseek-chat
AI_TIMEOUT=120

# SMTP email settings.
EMAIL_FROM=sender@example.com
EMAIL_PASSWORD=your_smtp_auth_code
EMAIL_TO=receiver@example.com
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
